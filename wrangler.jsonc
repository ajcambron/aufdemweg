// Cloudflare Workers (static assets) config.
// Cloudflare runs the build command (bundle exec jekyll build), then
// `npx wrangler deploy`, which uploads the built _site folder.
{
  "name": "aufdemweg",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  }
}
